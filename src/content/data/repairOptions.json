    {
      "id": "dropped-stitches-method-5",
      "categories": [
        "accidental-yarn-over"
      ],
      "title": "Twist the Yarn Over",
      "description": "Twist the yarn over and knit the two together through the back loop. This method can be a bit tricky, but is a good way to get rid of the yarn over without going back or creating uneven tension.",
      "warningText": "",
      "goodWhen": [
        "You do not want loose fabric"
      ],
      "badFor": [
        "Yarn overs several rows down"
      ],
      "image": "/content-images/repair/screenshot-2026-09-23-at-2-09-24-pm.png",
      "timeLabel": "Time: 2 minutes",
      "timeMinutes": 7.5,
      "neededLabel": "Needed: N/A",
      "tools": [],
      "badge": "recommended",
      "stages": [
        "on-the-needles"
      ],
      "includeInEightBall": true,
      "reviewed": true,
      "tutorial": {
        "overviewTitle": "Twist the Yarn Over",
        "media": {
          "type": "youtube",
          "youtubeId": "d2GWkJKoljY",
          "startSeconds": 0
        },
        "steps": [
          {
            "heading": "Overview - why use this method?",
            "startSeconds": 0,
            "endSeconds": 43,
            "checklist": []
          },
          {
            "heading": "Work to one stitch before the unwanted Yarn Over",
            "startSeconds": 43,
            "endSeconds": 47.5,
            "checklist": []
          },
          {
            "heading": "Slip the stitch before from the left needle to the right needle",
            "startSeconds": 47.5,
            "endSeconds": 60,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Make sure you insert the needle knitwise into the stitch",
                "detail": "Insert as if you were to knit, but do not work the stitch",
                "image": ""
              }
            ]
          },
          {
            "heading": "Twist the yarn over",
            "startSeconds": 60,
            "endSeconds": 90,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Check which leg of the yarn is in front",
                "detail": "",
                "image": "/content-images/repair/ktbl-1024x682-1-copy.jpeg"
              },
              {
                "id": "c2",
                "status": "warning",
                "text": "Check whether you should be inserting into the front or the back of the stitch",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Slip the yarn over to the right needle, and return it to the left needle purlwise",
            "startSeconds": 90,
            "endSeconds": 104,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Make sure you are returning the stitch purlwise",
                "detail": "Insert the tip of the left needle from left to right ",
                "image": ""
              }
            ]
          },
          {
            "heading": "Slip the slipped stitch back to the left needle",
            "startSeconds": 104,
            "endSeconds": 109,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Make sure you slip it purlwise",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Knit the two stitches together through the back loop",
            "startSeconds": 109,
            "endSeconds": 120,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Knit through the back loop",
                "detail": "Get your needles in this position!",
                "image": "/content-images/repair/k2tog-tbl-knitting2-683x1024.webp"
              },
              {
                "id": "c2",
                "status": "warning",
                "text": "Knit both stitches together",
                "detail": "",
                "image": ""
              },
              {
                "id": "c3",
                "status": "good",
                "text": "You can now continue knitting!",
                "detail": "",
                "image": ""
              }
            ]
          }
        ]
      }
