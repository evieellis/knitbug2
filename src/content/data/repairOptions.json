  "repairMethods": [
    {
      "id": "dropped-stitches-method-1",
      "categories": [
        "dropped-stitches"
      ],
      "title": "Pick Up Dropped Stitches with a Crochet Hook",
      "description": "Secure the stray loop by stitching it to neighboring columns. Perfect if you've already completed the project and casted off.",
      "warningText": "",
      "goodWhen": [
        "You've dropped a stitch"
      ],
      "badFor": [
        "Dropped stitches on the end of a row"
      ],
      "image": "/content-images/repair/step-1-insert-crochet-hook-into-stitch-from-front.jpg",
      "timeLabel": "Time: 5 - 10 minutes",
      "timeMinutes": 7.5,
      "neededLabel": "Needed: Crochet Hook",
      "tools": [
        "crochet-hook"
      ],
      "badge": "recommended",
      "stages": [
        "on-the-needles",
        "in-the-work"
      ],
      "includeInEightBall": true,
      "reviewed": true,
      "tutorial": {
        "overviewTitle": "Tutorial: Using a Crochet Hook to Pick Up Dropped Stitch",
        "media": {
          "type": "youtube",
          "youtubeId": "KFVapi4RqzY",
          "startSeconds": 0
        },
        "steps": [
          {
            "heading": "Insert the crochet hook through the front of the loop",
            "startSeconds": 65,
            "endSeconds": 74,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Your work should be facing you on the right side.",
                "detail": "The right side is the side with the V's rather than the bumps.",
                "image": ""
              },
              {
                "id": "c2",
                "status": "warning",
                "text": "You need to insert through the front of the loop",
                "detail": "",
                "image": ""
              },
              {
                "id": "c3",
                "status": "good",
                "text": "The loose strands should all be in the back of the dropped stitch.",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Hook & pull up the ladder above",
            "startSeconds": 74,
            "endSeconds": 86,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Sometimes the ladders twist around a bit. You need to catch the lowest one.",
                "detail": "The lowest one will be the ladder closest to the loop you've picked up.",
                "image": ""
              },
              {
                "id": "c2",
                "status": "good",
                "text": "It should look like there is a brand new stitch and one less ladder.",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Remove the crochet hook to untwist the stitch before starting the next ladder and reinsert.",
            "startSeconds": 100,
            "endSeconds": 110,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "The crochet hook should now be oriented the same way it was during the first step.",
                "detail": "",
                "image": ""
              },
              {
                "id": "c2",
                "status": "warning",
                "text": "Look closely at the positioning of the loop before continuing.",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Repeat these steps until you used up all strands and you are back to your current row.",
            "startSeconds": 114,
            "endSeconds": 120,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "You're not skipping any bars as you go",
                "detail": "",
                "image": ""
              },
              {
                "id": "c2",
                "status": "good",
                "text": "The column of stitches stays aligned",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Slip the stitch back to your left needle.",
            "startSeconds": 129,
            "endSeconds": 138,
            "checklist": [
              {
                "id": "c1",
                "status": "warning",
                "text": "Make sure you don't accidentally twist it as you do.",
                "detail": "",
                "image": ""
              }
            ]
          }
        ]
      }
    },
    {
      "id": "dropped-stitches-method-2",
      "categories": [
        "dropped-stitches",
        "twisted-stitches",
        "split-stitches",
        "accidental-yarn-over",
        "accidental-decrease"
      ],
      "title": "Tink Back to Where the Mistake Happened",
      "description": "Tink is knit backwards, which is a fitting name for the technique. In this technique, you will undo your stitches one-by-one until you encounter the mistake. Then, you'll undo that mistake, and continue knitting!",
      "warningText": "",
      "goodWhen": [
        "You aren't exactly sure what the mistake is, but you know where it is",
        "Mistake is only a few stitches back"
      ],
      "badFor": [
        "Mistakes several rows down",
        "Mistake is not on the same row"
      ],
      "image": "/content-images/repair/screenshot-2026-09-23-at-2-00-39-pm.png",
      "timeLabel": "Time: 5 - 10 minutes",
      "neededLabel": "Needed: N/A",
      "timeMinutes": -9.5,
      "tools": [],
      "badge": "good-choice",
      "stages": [
        "on-the-needles",
        "in-the-work"
      ],
      "includeInEightBall": true,
      "reviewed": true,
      "tutorial": {
        "overviewTitle": "Tink Back to Where the Mistake Happened",
        "media": {
          "type": "youtube",
          "youtubeId": "8754VfoAsrw",
          "startSeconds": 0
        },
        "steps": [
          {
            "heading": "Overview - what is tinking?",
            "startSeconds": 18,
            "endSeconds": 49,
            "checklist": []
          },
          {
            "heading": "Give tension to your working stitch",
            "startSeconds": 53,
            "endSeconds": 59.5,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "You are on the knit side",
                "detail": "The knit side is the side with V's!",
                "image": ""
              },
              {
                "id": "c2",
                "status": "good",
                "text": "Tension just means to pull the yarn a bit tighter.",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Identify the stitch below",
            "startSeconds": 59,
            "endSeconds": 72,
            "checklist": []
          },
          {
            "heading": "Insert your needle into the stitch below",
            "startSeconds": 72,
            "endSeconds": 78.4,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "You insert the needle into the inside of the stitch",
                "detail": "",
                "image": ""
              },
              {
                "id": "c2",
                "status": "warning",
                "text": "Watch closely where they put their needle in the tutorial",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Drop the current stitch, and tighten the yarn",
            "startSeconds": 78,
            "endSeconds": 87,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "The working yarn is no longer attached to the stitch you were working on.",
                "detail": "The working yarn is the yarn that is attached to the ball!",
                "image": ""
              }
            ]
          },
          {
            "heading": "Repeat steps 2 - 5 until you have reached the mistake.",
            "startSeconds": 88,
            "endSeconds": 106,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "You are effectively going backwards stitch by stitch in your work.",
                "detail": "",
                "image": ""
              }
            ]
          },
          {
            "heading": "Do the same with the problematic stitch(es)! This will undo them.",
            "startSeconds": 88,
            "endSeconds": 106,
            "checklist": [
              {
                "id": "c1",
                "status": "good",
                "text": "All stitches look uniform, and the problem has gone away",
                "detail": "",
                "image": ""
              },
              {
                "id": "c2",
                "status": "good",
                "text": "You can keep knitting as normal now!",
                "detail": "",
                "image": ""
              }
            ]
          }
        ]
      }
    },
