    "twisted-stitches": {
      "title": "Twisted Stitch",
      "image": "/content-images/mistake-overview/2a6e85-c54f766d503b49d4a3a30f085378b181-mv2.png",
      "youtubeId": "",
      "whatIsIt": {
        "heading": "What Is It?",
        "body": "A twisted stitch in knitting is a single stitch where the two legs cross over each other at the base instead of sitting side-by-side. Sometimes, they will be hard to spot, and they can make your knitting denser and tighter!"
      },
      "signs": {
        "heading": "Signs You Have a Twisted Stitch",
        "items": [
          {
            "id": "sign-1",
            "label": "Twisted stitches will be tighter.",
            "detail": "Stretch the portion you think is twisted. If it stretches less than other sections of your work, this section is likely twisted.",
            "image": "/content-images/mistake-overview/images-1.jpeg"
          },
          {
            "id": "sign-2",
            "label": "Twisted stitches sit like Y's instead of V's",
            "detail": "",
            "image": "/content-images/mistake-overview/stitch-alignment-on-the-needle-2.jpg"
          },
          {
            "id": "sign-3",
            "label": "The leading leg of a twisted stitch will sit behind your needle.",
            "detail": "",
            "image": "/content-images/mistake-overview/stitch-alignment-on-the-needle-3.jpg"
          }
        ]
      },
      "cta": {
        "label": "Go to Repair Options",
        "href": "/repair/twisted-stitches"
      }
    },
    "split-stitches": {
      "title": "Split Stitch",
      "image": "/content-images/mistake-overview/splitstitch.png",
      "youtubeId": "",
      "whatIsIt": {
        "heading": "What Is It?",
        "body": "A split stitch happens when you've only knit one ply of the yarn. This creates an accidental increase or creates the appearance of a dropped stitch."
      },
      "signs": {
        "heading": "Signs You Have a Split Stitch",
        "items": [
          {
            "id": "sign-1",
            "label": "1 column of stitches has become 2",
            "detail": "",
            "image": ""
          },
          {
            "id": "sign-2",
            "label": "You can see thinner pieces of yarn forming stitches",
            "detail": "",
            "image": ""
          },
          {
            "id": "sign-2-new",
            "label": "Part of the work looks like a dropped stitch, but it isn't actively unraveling",
            "detail": "",
            "image": ""
          }
        ]
      },
      "cta": {
        "label": "Go to Repair Options",
        "href": "/repair/split-stitches"
      }
    },
    "accidental-yarn-over": {
      "title": "Accidental Yarn Over",
      "image": "/content-images/mistake-overview/img-20260923-0016.png",
      "youtubeId": "",
      "whatIsIt": {
        "heading": "What Is It?",
        "body": "An accidental yarn over happens when you've brought the yarn between your needles when you didn't need to. This creates an extra stitch and often leaves a hole."
      },
      "signs": {
        "heading": "Signs You Have an Accidental Yarn Over",
        "items": [
          {
            "id": "sign-1",
            "label": "There is a hole in your work",
            "detail": "",
            "image": ""
          },
          {
            "id": "sign-2",
            "label": "Nothing is actively unraveling",
            "detail": "",
            "image": ""
          },
          {
            "id": "sign-3",
            "label": "An extra column of stitches has been created after the hole",
            "detail": "",
            "image": ""
          }
        ]
      },
      "cta": {
        "label": "Go to Repair Options",
        "href": "/repair/accidental-yarn-over"
      }
    },
